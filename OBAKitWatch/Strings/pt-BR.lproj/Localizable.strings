/* Empty state */
"arrivals.empty" = "Nenhuma partida nos próximos 60 minutos.";

/* Progress text */
"arrivals.loading" = "Carregando partidas…";

/* Arrivals cannot load without a region */
"arrivals.no_service" = "Nenhuma região de transporte selecionada.";

/* VoiceOver: route, headsign, time until departure */
"arrivals.row.a11y_fmt" = "%1$@ para %2$@, %3$@";

/* %@ is a short time, e.g. 3:42 PM */
"arrivals.updated_at_fmt" = "Atualizado: %@";

/* Shown while the system location prompt is up */
"nearby.awaiting_authorization" = "Permita o acesso à localização para ver as paradas perto de você.";

/* No nearby stop has a departure in the next 60 minutes */
"nearby.empty" = "Nenhuma partida por perto na próxima hora.";

/* Progress text */
"nearby.locating" = "Encontrando sua localização…";

/* Shown when a location fix fails or times out */
"nearby.location_failed" = "Não foi possível encontrar sua localização. Tente novamente.";

/* Shown when location is denied or restricted */
"nearby.location_denied" = "O acesso à localização está desativado. As paradas próximas precisam da sua localização.";

/* The fix is outside every supported region */
"nearby.no_region" = "Nenhuma região de transporte aqui.";

/* Screen title before a transit region is known */
"nearby.title" = "Por perto";

/* Progress text while nearby stops' departures load */
"nearby.loading" = "Procurando linhas próximas…";

/* VoiceOver: route short name, headsign. e.g. 'C Line to South Lake Union' */
"nearby.card.a11y_fmt" = "%1$@ para %2$@";

/* Section header: other nearby stops served by the same route and direction */
"route.also_nearby" = "Também por perto";

/* Opens every route's departures at the nearest stop */
"route.all_arrivals" = "Todas as chegadas neste ponto";

/* Button: show the same route heading the other way */
"route.switch_direction" = "Trocar sentido";
