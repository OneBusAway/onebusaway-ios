find OBAKitCore OBAKitCoreiOS -name "*.swift" -print0 | xargs -0 genstrings -s OBALoc -o OBAKitCore/Strings/en.lproj
iconv -f UTF-16 -t UTF-8 OBAKitCore/Strings/en.lproj/Localizable.strings > OBAKitCore/Strings/en.lproj/Localizable.strings.new
mv -f OBAKitCore/Strings/en.lproj/Localizable.strings.new OBAKitCore/Strings/en.lproj/Localizable.strings

find OBAKit -name "*.swift" -print0 | xargs -0 genstrings -s OBALoc -o OBAKit/Strings/en.lproj
iconv -f UTF-16 -t UTF-8 OBAKit/Strings/en.lproj/Localizable.strings > OBAKit/Strings/en.lproj/Localizable.strings.new
mv -f OBAKit/Strings/en.lproj/Localizable.strings.new OBAKit/Strings/en.lproj/Localizable.strings

mkdir -p OBAKitWatch/Strings/en.lproj
find OBAKitWatch -name "*.swift" -print0 | xargs -0 genstrings -s OBALoc -o OBAKitWatch/Strings/en.lproj
iconv -f UTF-16 -t UTF-8 OBAKitWatch/Strings/en.lproj/Localizable.strings > OBAKitWatch/Strings/en.lproj/Localizable.strings.new
mv -f OBAKitWatch/Strings/en.lproj/Localizable.strings.new OBAKitWatch/Strings/en.lproj/Localizable.strings

# OBAWidget has no Localizable.strings of its own: its copy lives in OBAKitCore
# (OBAKitCoreiOS/Widget/WidgetStrings.swift) and is extracted with that module above.
# AppIntents.strings (OBAKit, OBAWidget) and AppShortcuts.strings (OBAKit) are
# hand-maintained: genstrings cannot read LocalizedStringResource keys or App
# Shortcut phrases, and this script must not overwrite them. Fail if someone adds
# an OBALoc table to the widget, so it cannot silently go unextracted.
if grep -rq --include='*.swift' 'func OBALoc' OBAWidget; then
    echo "OBAWidget defines OBALoc; put widget strings in OBAKitCore's WidgetStrings instead." >&2
    exit 1
fi
