#!/usr/bin/env ruby

require 'date'

PLISTBUDDY_PATH = "/usr/libexec/PlistBuddy"

def update_build_version(label, plist_path, build_version)
  `#{PLISTBUDDY_PATH} -c "Set :CFBundleVersion #{build_version}" #{plist_path}`
end

def update_all_apps
  apps = Dir.glob("Apps/*") - ["Apps/Shared"]
  apps += ["OBAKit", "OBAKitCore", "OBAWidget", "OBAKitWatch", "WatchApp"]
  launch_directory = Dir.pwd

  # Minute resolution, not hour: two merges to main within the same hour would
  # otherwise stamp identical CFBundleVersions and TestFlight rejects the second
  # upload as a duplicate build. Still monotonically increasing against the
  # hour-resolution numbers already uploaded, because CFBundleVersion components
  # compare numerically (20260726.1502 > 20260726.15).
  #
  # OBA_BUILD_VERSION pins the number across every stamp of one archive. This
  # script runs from generate_project and again from the App target's
  # Versioning pre-build phase, but WatchApp and OBAWidget are built before
  # that phase and keep the earlier stamp; App Store Connect rejects a watch
  # app whose CFBundleVersion differs from its iOS app's. fastlane/Fastfile
  # sets it; without it, each run stamps the current minute.
  build_version = ENV["OBA_BUILD_VERSION"].to_s.strip
  build_version = DateTime.now.strftime("%Y%m%d.%H%M") if build_version.empty?

  puts "Updating bundle build number to #{build_version}."

  apps.each do |app_path|
    label = app_path
    plist = Dir["#{app_path}/Info.plist"].first
    # Not every target is generated for every app (no watch.yml, --no-watch).
    next unless plist

    abs_path = "#{launch_directory}/#{plist}"
    update_build_version(label, abs_path, build_version)
  end
end

update_all_apps