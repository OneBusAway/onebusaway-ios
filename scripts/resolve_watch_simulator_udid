#!/usr/bin/env bash
#
# Prints the UDID of the first available Apple Watch simulator on the newest
# installed watchOS runtime, creating one from the newest Apple Watch device
# type if none exists. Mirrors scripts/resolve_simulator_udid: address devices
# by id=, never by a name that goes stale every Xcode release.
#
# Devices are matched by device type, not by name: the one this script creates
# is not named "Apple Watch …", and matching on the name would create another
# on every run.
#
# Usage:
#   WATCH_UDID=$(scripts/resolve_watch_simulator_udid)
#   xcodebuild ... -destination "platform=watchOS Simulator,id=$WATCH_UDID"

set -euo pipefail

if ! list_json=$(xcrun simctl list -j 2>&1); then
    echo "error: \`xcrun simctl\` failed:" >&2
    echo "$list_json" >&2
    exit 1
fi

udid=$(printf '%s' "$list_json" | python3 -c '
import json, re, sys

try:
    data = json.load(sys.stdin)
    devices = data.get("devices", {})
    runtimes = data.get("runtimes", [])
except (json.JSONDecodeError, KeyError, TypeError) as error:
    sys.exit("error: could not parse simctl list output: " + str(error))

available_runtimes = set()
for r in runtimes:
    if r.get("platform") == "watchOS" and r.get("isAvailable", False):
        if "identifier" in r:
            available_runtimes.add(r["identifier"])
        if "name" in r:
            available_runtimes.add(r["name"])

def version(runtime):
    match = re.search(r"watchOS[ -](\d+)[.-](\d+)", runtime)
    return (int(match.group(1)), int(match.group(2))) if match else (0, 0)

valid_runtimes = [r for r in devices if r in available_runtimes]
valid_runtimes.sort(key=version, reverse=True)

for runtime in valid_runtimes:
    watches = [d for d in devices[runtime] if "Apple-Watch" in d.get("deviceTypeIdentifier", "") and d.get("isAvailable", True)]
    if watches:
        print(watches[0]["udid"])
        break
')

if [ -z "$udid" ]; then
    # No device on any available watchOS runtime: create one from the newest runtime and
    # the first Apple Watch device type it supports.
    runtime=$(printf '%s' "$list_json" | python3 -c '
import json, re, sys
try:
    runtimes = [r for r in json.load(sys.stdin).get("runtimes", []) if r.get("platform") == "watchOS" and r.get("isAvailable", False)]
except Exception as error:
    sys.exit("error parsing runtimes: " + str(error))
if not runtimes:
    sys.exit("error: no watchOS runtime is installed. Run: xcodebuild -downloadPlatform watchOS")
runtimes.sort(key=lambda r: [int(x) for x in re.findall(r"\d+", r.get("version", "0"))], reverse=True)
print(runtimes[0]["identifier"])
')
    devicetype=$(printf '%s' "$list_json" | python3 -c '
import json, sys
try:
    types = [t for t in json.load(sys.stdin).get("devicetypes", []) if t.get("name", "").startswith("Apple Watch")]
except Exception as error:
    sys.exit("error parsing devicetypes: " + str(error))
if not types:
    sys.exit("error: no Apple Watch device types are installed.")
print(types[0]["identifier"])
')
    udid=$(xcrun simctl create "OBA Watch Smoke" "$devicetype" "$runtime")
fi

printf '%s\n' "$udid"
