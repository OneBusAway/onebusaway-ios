#!/usr/bin/env python3
"""
validate_watch_localizations

Validates watch localization completeness, format specifiers, and translation integrity
against intentional fallback allowlist before review / in CI.
"""

import json
import re
import subprocess
import sys
import unicodedata
from pathlib import Path


SPECIFIER_REGEX = re.compile(r"%(?:\d+\$)?[@dfs]|%%")

LOCALES = ["ar", "en", "es", "fil", "fr", "it", "ko", "pl", "pt-BR", "ru", "vi", "zh-Hans", "zh-Hant"]
TABLES = [
    ("OBAKitWatch/Strings", "Localizable"),
    ("Apps/Shared/HealthKit/Sources", "HealthKit"),
]


def parse_strings_file(file_path: Path) -> dict:
    if not file_path.exists():
        return None
    try:
        proc = subprocess.run(
            ["plutil", "-convert", "json", "-o", "-", str(file_path)],
            capture_output=True,
            text=True,
            check=True
        )
        data = json.loads(proc.stdout)
        if not isinstance(data, dict) or not all(isinstance(k, str) and isinstance(v, str) for k, v in data.items()):
            print(f"[WARN] Invalid format or non-string values in strings file: {file_path}", file=sys.stderr)
            return None
        return data
    except Exception as e:
        print(f"[WARN] Failed to parse {file_path} with plutil: {e}", file=sys.stderr)
        return None


def extract_specifiers(value: str) -> list:
    specifiers = []
    implicit_index = 1
    for match in SPECIFIER_REGEX.finditer(value):
        token = match.group(0)
        if token == "%%":
            specifiers.append("%%")
        elif "$" in token:
            specifiers.append(token)
        else:
            arg_type = token[1:]
            specifiers.append(f"%{implicit_index}${arg_type}")
            implicit_index += 1
    return sorted(specifiers)


def load_allowlist(repo_root: Path) -> dict:
    allowlist_path = repo_root / "OBAKitWatch" / "Strings" / "fallback_allowlist.json"
    if not allowlist_path.exists():
        print(f"[ERROR] Fallback allowlist not found at {allowlist_path}", file=sys.stderr)
        sys.exit(1)
    try:
        with open(allowlist_path, "r", encoding="utf-8") as f:
            allowlist = json.load(f)
    except json.JSONDecodeError as e:
        print(f"[ERROR] Malformed JSON in fallback allowlist at {allowlist_path}: {e}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"[ERROR] Failed to read fallback allowlist at {allowlist_path}: {e}", file=sys.stderr)
        sys.exit(1)

    if not isinstance(allowlist, dict):
        print(f"[ERROR] Fallback allowlist root must be a JSON object: {allowlist_path}", file=sys.stderr)
        sys.exit(1)

    for section in ["intentional_fallbacks", "allowed_missing"]:
        if section not in allowlist or not isinstance(allowlist[section], dict):
            print(f"[ERROR] Fallback allowlist missing or invalid '{section}' object in {allowlist_path}", file=sys.stderr)
            sys.exit(1)

    fallbacks = allowlist["intentional_fallbacks"]
    if "all" not in fallbacks or not isinstance(fallbacks["all"], list) or not all(isinstance(k, str) for k in fallbacks["all"]):
        print(f"[ERROR] 'intentional_fallbacks.all' must be an array of strings in {allowlist_path}", file=sys.stderr)
        sys.exit(1)

    if "by_locale" not in fallbacks or not isinstance(fallbacks["by_locale"], dict) or not all(
        isinstance(loc, str) and isinstance(keys, list) and all(isinstance(k, str) for k in keys)
        for loc, keys in fallbacks["by_locale"].items()
    ):
        print(f"[ERROR] 'intentional_fallbacks.by_locale' must be a map of locale strings to string arrays in {allowlist_path}", file=sys.stderr)
        sys.exit(1)

    missing = allowlist["allowed_missing"]
    if "by_locale" not in missing or not isinstance(missing["by_locale"], dict) or not all(
        isinstance(loc, str) and isinstance(keys, list) and all(isinstance(k, str) for k in keys)
        for loc, keys in missing["by_locale"].items()
    ):
        print(f"[ERROR] 'allowed_missing.by_locale' must be a map of locale strings to string arrays in {allowlist_path}", file=sys.stderr)
        sys.exit(1)

    return allowlist


def is_intentional_fallback(allowlist: dict, key: str, locale: str) -> bool:
    fallbacks = allowlist.get("intentional_fallbacks", {})
    if key in fallbacks.get("all", []):
        return True
    by_locale = fallbacks.get("by_locale", {})
    if key in by_locale.get(locale, []):
        return True
    return False


def is_allowed_missing(allowlist: dict, key: str, locale: str) -> bool:
    allowed_missing = allowlist.get("allowed_missing", {}).get("by_locale", {})
    return key in allowed_missing.get(locale, [])


def validate_allowlist(allowlist: dict, all_en_keys: set, failures: list):
    fallbacks = allowlist.get("intentional_fallbacks", {})
    for key in fallbacks.get("all", []):
        if key not in all_en_keys:
            failures.append(f"File: OBAKitWatch/Strings/fallback_allowlist.json: Key '{key}' does not exist in English base tables")

    for locale, keys in fallbacks.get("by_locale", {}).items():
        if locale not in LOCALES:
            failures.append(f"File: OBAKitWatch/Strings/fallback_allowlist.json: Unknown locale '{locale}' in intentional_fallbacks")
        for key in keys:
            if key not in all_en_keys:
                failures.append(f"File: OBAKitWatch/Strings/fallback_allowlist.json, Locale: {locale}: Key '{key}' does not exist in English base tables")

    allowed_missing = allowlist.get("allowed_missing", {})
    for locale, keys in allowed_missing.get("by_locale", {}).items():
        if locale not in LOCALES:
            failures.append(f"File: OBAKitWatch/Strings/fallback_allowlist.json: Unknown locale '{locale}' in allowed_missing")
        for key in keys:
            if key not in all_en_keys:
                failures.append(f"File: OBAKitWatch/Strings/fallback_allowlist.json, Locale: {locale}: Key '{key}' does not exist in English base tables")


def main():
    repo_root = Path(__file__).resolve().parent.parent
    allowlist = load_allowlist(repo_root)

    failures = []
    total_checks = 0
    all_en_keys = set()

    print("=== Validating Watch Localization Completeness ===")

    # First pass: collect English keys from all tables
    parsed_tables = {}
    for directory, table_name in TABLES:
        en_path = repo_root / directory / "en.lproj" / f"{table_name}.strings"
        en_strings = parse_strings_file(en_path)
        if not en_strings:
            failures.append(f"File: {directory}/en.lproj/{table_name}.strings: Base English table missing or empty")
            continue
        parsed_tables[(directory, table_name)] = en_strings
        all_en_keys.update(en_strings.keys())

    # Validate allowlist keys against collected English keys
    validate_allowlist(allowlist, all_en_keys, failures)

    for (directory, table_name), en_strings in parsed_tables.items():
        for locale in LOCALES:
            if locale == "en":
                continue

            rel_file = f"{directory}/{locale}.lproj/{table_name}.strings"
            locale_path = repo_root / directory / f"{locale}.lproj" / f"{table_name}.strings"
            locale_strings = parse_strings_file(locale_path)

            if locale_strings is None:
                failures.append(f"File: {rel_file}, Locale: {locale}: Strings table file not found")
                continue

            # 1. Key Parity: Check missing keys
            for key in sorted(en_strings.keys()):
                total_checks += 1
                if key not in locale_strings:
                    if not is_allowed_missing(allowlist, key, locale):
                        failures.append(f"File: {rel_file}, Locale: {locale}, Key: '{key}': Missing key from English base table")
                else:
                    # 2. Format Specifiers: Check argument consistency
                    en_spec = extract_specifiers(en_strings[key])
                    loc_spec = extract_specifiers(locale_strings[key])
                    if en_spec != loc_spec:
                        failures.append(f"File: {rel_file}, Locale: {locale}, Key: '{key}': Format arguments differ (expected {en_spec}, got {loc_spec})")

                    # 3. Fallback Check: Check untranslated English values or empty/whitespace values
                    val = locale_strings[key]
                    if not val.strip() and not is_intentional_fallback(allowlist, key, locale):
                        failures.append(f"File: {rel_file}, Locale: {locale}, Key: '{key}': Empty or whitespace-only translation value without intentional fallback allowlist entry")
                    elif (
                        len(val) > 3
                        and unicodedata.normalize("NFC", val) == unicodedata.normalize("NFC", en_strings[key])
                        and not is_intentional_fallback(allowlist, key, locale)
                    ):
                        failures.append(f"File: {rel_file}, Locale: {locale}, Key: '{key}': Untranslated English value without intentional fallback allowlist entry")

            # Check extra keys
            for key in sorted(locale_strings.keys()):
                if key not in en_strings:
                    failures.append(f"File: {rel_file}, Locale: {locale}, Key: '{key}': Extra key not in English base table")

    # 4. InfoPlist checks
    for locale in LOCALES:
        if locale == "en":
            continue
        info_rel = f"WatchApp/{locale}.lproj/InfoPlist.strings"
        info_path = repo_root / "WatchApp" / f"{locale}.lproj" / "InfoPlist.strings"
        info_strings = parse_strings_file(info_path)
        total_checks += 1
        desc = info_strings.get("NSLocationWhenInUseUsageDescription") if info_strings else None
        if not isinstance(desc, str) or not desc.strip():
            failures.append(f"File: {info_rel}, Locale: {locale}, Key: 'NSLocationWhenInUseUsageDescription': Missing or empty location purpose string")

    if failures:
        print(f"\n[FAIL] Localization validation failed with {len(failures)} error(s):")
        for failure in failures:
            print(f"  • {failure}")
        sys.exit(1)
    else:
        print(f"\n[PASS] All watch localization tables validated successfully ({total_checks} key checks across {len(LOCALES)} locales).")
        sys.exit(0)


if __name__ == "__main__":
    main()
