#!/usr/bin/env python3
"""Turn a recorded trip-details poll log into a vehicle-estimation replay fixture.

The recording is JSON Lines, one poll per line:
    {"route": "...", "requestTime": s, "receiveTime": s,
     "headers": {"Age": ...}, "response": <trip-details response>}
and the trip's shape response sits beside it as shape_<shapeId>.json.

The fixture keeps what VehicleEstimationReplayTests needs, and nothing else: the
shape, the stop times, and each distinct fix with when it first arrived.

Usage: scripts/vehicle_replay_fixture RECORDING.jsonl SHAPE_DIR OUTPUT.json
"""
import json
import sys


def main(recording, shape_dir, output):
    polls = [json.loads(line) for line in open(recording)]
    polls = [p for p in polls if p["response"].get("code") == 200 and p["response"].get("data", {}).get("entry")]
    if not polls:
        sys.exit(f"{recording}: no usable polls")

    first = polls[0]["response"]["data"]
    entry = first["entry"]
    trip_id = entry["tripId"]
    trip = next(t for t in first["references"]["trips"] if t["id"] == trip_id)
    shape = json.load(open(f"{shape_dir}/shape_{trip['shapeId']}.json"))["data"]["entry"]["points"]

    observations, seen = [], set()
    for poll in polls:
        response = poll["response"]
        status = response["data"]["entry"].get("status") or {}
        fix_time = status.get("lastLocationUpdateTime") or 0
        location = status.get("lastKnownLocation")
        if not fix_time or not location or fix_time in seen:
            continue
        seen.add(fix_time)
        age = float((poll.get("headers") or {}).get("Age") or 0)
        position = status.get("position") or {}
        observations.append({
            "receivedAt": round(poll["receiveTime"], 3),
            "serverTime": response["currentTime"] / 1000 + age,
            "fixTime": fix_time / 1000,
            "lat": location["lat"],
            "lon": location["lon"],
            "positionLat": position.get("lat"),
            "positionLon": position.get("lon"),
            "activeTripId": status.get("activeTripId"),
            "vehicleId": status.get("vehicleId"),
            "predicted": status.get("predicted", False),
            "scheduleDeviation": status.get("scheduleDeviation", 0),
            "totalDistanceAlongTrip": status.get("totalDistanceAlongTrip"),
        })

    fixture = {
        "source": "api.pugetsound.onebusaway.org trip-details, polled every 15 s",
        "route": polls[0]["route"],
        "tripId": trip_id,
        "serviceDate": entry["serviceDate"] / 1000,
        "shape": shape,
        "stopTimes": [
            {"distanceAlongTrip": st.get("distanceAlongTrip"), "arrivalTime": st["arrivalTime"], "departureTime": st["departureTime"]}
            for st in entry["schedule"]["stopTimes"]
        ],
        "observations": observations,
    }
    with open(output, "w") as f:
        json.dump(fixture, f, separators=(",", ":"))
    print(f"{output}: {len(observations)} fixes, {len(fixture['stopTimes'])} stops")


if __name__ == "__main__":
    if len(sys.argv) != 4:
        sys.exit(__doc__)
    main(*sys.argv[1:])
