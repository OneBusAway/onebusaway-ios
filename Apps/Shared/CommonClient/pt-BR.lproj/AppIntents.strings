/*
 * App Intents strings. Hand-maintained: scripts/extract_strings (genstrings -s OBALoc)
 * does not read LocalizedStringResource, so it neither adds nor removes these keys.
 * Siri and Shortcuts resolve them out of process from this bundle's Metadata.appintents.
 */

/* App Intents: type name of a bookmarked trip in Shortcuts and Siri. Singular noun. */
"bookmark_entity.type_name" = "Favorito";

/* App Intents: label of the bookmark parameter on the Track Bookmark and Next Departures actions. */
"bookmark_entity.parameter_title" = "Favorito";

/* App Intents: description of the Next Departures at Stop action in Shortcuts. Siri speaks the answer. */
"next_departures_at_stop_intent.description" = "Ouça as próximas partidas de uma parada.";

/* App Shortcuts: short tile label for Next Departures at Stop in Shortcuts and Spotlight. */
"next_departures_at_stop_intent.short_title" = "Partidas na parada";

/* App Intents: name of the Shortcuts action that answers when buses and trains next leave a stop. */
"next_departures_at_stop_intent.title" = "Próximas Partidas na Parada";

/* App Intents: name of the Shortcuts action that answers when a bookmarked trip departs next. */
"next_departures_intent.title" = "Próximas Partidas";

/* App Intents: description of the Next Departures action in Shortcuts. Siri speaks the answer. */
"next_departures_intent.description" = "Ouça quando sai a próxima partida de uma viagem salva nos favoritos.";

/* App Shortcuts: short tile label for Next Departures in Shortcuts and Spotlight. */
"next_departures_intent.short_title" = "Próximas partidas";

/* App Intents: name of the Shortcuts action that opens a transit stop in the app. */
"open_stop_intent.title" = "Abrir Parada";

/* App Intents: description of the Open Stop action in Shortcuts. */
"open_stop_intent.description" = "Abra uma parada para ver suas partidas.";

/* App Intents: type name of a transit stop in Shortcuts, Siri and Spotlight. Singular noun. */
"stop_entity.type_name" = "Parada";

/* App Intents: label of the stop parameter on the Open Stop and Next Departures at Stop actions. */
"stop_entity.parameter_title" = "Parada";

/* App Intents: name of the Next Departures card's Refresh button action. Not listed in Shortcuts; shown only where the system names the action. */
"refresh_next_departures_intent.title" = "Atualizar Próximas Partidas";

/* App Intents: name of the Shortcuts action that starts a Live Activity for a bookmarked trip. */
"track_bookmark_intent.title" = "Acompanhar Favorito";

/* App Intents: description of the Track Bookmark action in Shortcuts. */
"track_bookmark_intent.description" = "Inicie uma Atividade ao Vivo para uma viagem salva nos favoritos.";

/* App Shortcuts: short tile label for Track Bookmark in Shortcuts and Spotlight. */
"track_bookmark_intent.short_title" = "Acompanhar favorito";
