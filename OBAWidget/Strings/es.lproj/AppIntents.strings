"previous_bookmark_page_intent.title" = "Página anterior de marcadores";

/* App Intents: name of the Live Activity action that refreshes arrivals. */
"refresh_live_activity_intent.title" = "Actualizar actividad en vivo";

/* App Intents: name of the Live Activity action that ends and dismisses the Live Activity. */
"end_live_activity_intent.title" = "Finalizar actividad en vivo";

