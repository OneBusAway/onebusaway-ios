/*
 * App Intents strings. Hand-maintained: scripts/extract_strings (genstrings -s OBALoc)
 * does not read LocalizedStringResource, so it neither adds nor removes these keys.
 * Siri and Shortcuts resolve them out of process from this bundle's Metadata.appintents.
 */

/* App Intents: name of the widget action that reloads departures. */
"refresh_widget_intent.title" = "Refresh Widget";

/* App Intents: title of the bookmarks widget configuration. */
"widget_configuration_intent.title" = "Bookmarks";

/* App Intents: description of the bookmarks widget configuration. */
"widget_configuration_intent.description" = "See upcoming departures for your bookmarks.";

/* App Intents: name of the widget action that shows the next page of bookmarks. */
"next_bookmark_page_intent.title" = "Next Bookmarks Page";

/* App Intents: name of the widget action that shows the previous page of bookmarks. */
"previous_bookmark_page_intent.title" = "Previous Bookmarks Page";

/* App Intents: name of the Live Activity action that refreshes arrivals. */
"refresh_live_activity_intent.title" = "Refresh Live Activity";

/* App Intents: name of the Live Activity action that ends and dismisses the Live Activity. */
"end_live_activity_intent.title" = "End Live Activity";

/* App Intents: parameter title for the Live Activity identifier. */
"live_activity_intent.activity_id_parameter_title" = "Activity ID";
